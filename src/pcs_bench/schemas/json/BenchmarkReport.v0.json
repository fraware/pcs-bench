{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.dev/schemas/BenchmarkReport.v0.json",
  "title": "BenchmarkReport.v0",
  "type": "object",
  "required": ["schema_version", "report_id", "benchmark_suite_id", "started_at", "runs", "metrics"],
  "properties": {
    "schema_version": { "const": "v0" },
    "report_id": { "type": "string" },
    "benchmark_suite_id": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": ["string", "null"] },
    "repo_commits": { "type": "object" },
    "runs": { "type": "array" },
    "metrics": { "type": "object" },
    "metric_summaries": { "type": "array" },
    "summary": { "type": "object" },
    "coverage": { "type": "object" },
    "failures": { "type": "array" },
    "signature_or_digest": { "type": ["string", "null"] },
    "dry_run": { "type": "boolean" }
  },
  "additionalProperties": true
}
